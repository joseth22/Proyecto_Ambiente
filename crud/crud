if ($result->num_rows > 0) {
    while ($row = $result->fetch_assoc()) {
        echo "ID: " . $row["id"] . "<br>";
        echo "Nombre: " . $row["nombre"] . "<br>";
        echo "Correo: " . $row["correo"] . "<br>";
        echo "Teléfono: " . $row["telefono"] . "<br>";
        echo "Mensaje: " . $row["mensaje"] . "<br><br>";
    }
} else {
